diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
--- a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -628,3 +628,44 @@
 	/* CNTFRQ is not reliably programmed by this firmware (stock DT sets it) */
 	clock-frequency = <13000000>;
 };
+
+/* Experimental render-only integration; the inherited framebuffer is unchanged. */
+/ {
+	mfg_retained: system-controller@13000000 {
+		compatible = "mediatek,mt6750-mfg-retained";
+		reg = <0 0x13000000 0 0x200>,
+		      <0 0x1000c000 0 0x1000>,
+		      <0 0x10000000 0 0x1000>,
+		      <0 0x10006000 0 0x1000>,
+		      <0 0x10001000 0 0x1000>,
+		      <0 0x14000000 0 0x1000>,
+		      <0 0x1000cf00 0 0x100>;
+		reg-names = "mfg", "apmixed", "topckgen", "spm", "infracfg",
+			    "mmsys", "fhctl";
+		clocks = <&uart_clk>;
+		clock-names = "ref";
+		#clock-cells = <0>;
+		#power-domain-cells = <0>;
+	};
+
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-351000000 {
+			opp-hz = /bits/ 64 <351000000>;
+		};
+	};
+
+	gpu: gpu@13040000 {
+		compatible = "mediatek,mt6750-mali", "arm,mali-t860";
+		reg = <0 0x13040000 0 0x4000>;
+		interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_SPI 217 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_SPI 216 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-names = "job", "mmu", "gpu";
+		clocks = <&mfg_retained>;
+		clock-names = "core";
+		power-domains = <&mfg_retained>;
+		operating-points-v2 = <&gpu_opp_table>;
+	};
+};
